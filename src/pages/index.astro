---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import {repos} from '../data/site';
const base = import.meta.env.BASE_URL;
const href = (p='') => `${base}${p}`;
---
<Layout title="Modern engineering for InterSystems IRIS">
<section class="hero"><div class="container hero-grid"><div><span class="eyebrow">ENGINEERING BEYOND THE DATABASE</span><h1>IRIS is powerful.<br/><span class="accent-text">Your ecosystem should be too.</span></h1><p class="lede">We build the missing connections between InterSystems IRIS and the modern data stack. Open-source tooling, real-time integration and engineering for systems that matter.</p><div class="hero-actions"><a class="button button-primary" href={href('products/iris-cdc/')}>Explore IRIS CDC <span aria-hidden="true">↗</span></a><a class="button button-outline" href={href('open-source/')}>Our open-source work <span aria-hidden="true">↗</span></a></div><div class="hero-proof">INDEPENDENT ENGINEERING <span class="kicker-separator">/</span> BUILT AROUND INTERSYSTEMS IRIS</div></div><div class="hero-visual" aria-label="Illustrative code snippet showing IRIS integrations"><div class="code-panel"><div class="code-top"><span class="dot"></span><span class="dot"></span><span class="dot"></span><span class="code-filename">ecosystem.ts</span></div><div class="code-content"><div><span class="c-muted">// Connecting IRIS to what comes next</span></div><div><span class="c-blue">const</span> platform = <span class="c-green">'InterSystems IRIS'</span>;</div><br/><div><span class="c-blue">const</span> ecosystem = &#123;</div><div>&nbsp;&nbsp; python: <span class="c-green">'SQLAlchemy / Django'</span>,</div><div>&nbsp;&nbsp; analytics: <span class="c-green">'dbt'</span>,</div><div>&nbsp;&nbsp; typescript: <span class="c-green">'TypeORM'</span>,</div><div>&nbsp;&nbsp; ai: <span class="c-green">'LangChain / MCP'</span>,</div><div>&nbsp;&nbsp; events: <span class="c-green">'CDC → Kafka'</span></div><div>&#125;;</div><br/><div><span class="c-muted">// The next chapter starts here.</span></div></div><div class="status-strip"><span class="status-light"></span><span>Modern IRIS ecosystem</span><span style="margin-left:auto">● active</span></div></div><div class="visual-badge">{`{ innovation: "in motion" }`}</div></div></div></section>
<section class="section section-light"><div class="container"><div class="section-heading"><span class="eyebrow dark">WHAT WE BUILD</span><h2>Built for the hard parts.</h2><p>From open-source integrations to specialised enterprise engineering, we help established IRIS systems participate in modern architectures.</p></div><div class="feature-grid"><a class="feature-card" href={href('products/iris-cdc/')}><span class="card-index">01 / PRODUCTS</span><h3>Real-time data. Without the detours.</h3><p>Explore our work on journal-based change data capture for streaming IRIS changes into Kafka.</p><span class="text-link">Discover IRIS CDC <span>↗</span></span></a><a class="feature-card" href={href('open-source/')}><span class="card-index">02 / OPEN SOURCE</span><h3>Native to your stack.</h3><p>Use the frameworks you already know. We maintain integrations for Python, TypeScript, analytics and AI.</p><span class="text-link">Explore projects <span>↗</span></span></a><a class="feature-card" href={href('services/')}><span class="card-index">03 / ENGINEERING</span><h3>Deep IRIS experience. Practical outcomes.</h3><p>Modernisation, integration, performance and reliability for complex enterprise environments.</p><span class="text-link">See our services <span>↗</span></span></a></div></div></section>
<section class="section section-dark"><div class="container product-feature"><div class="product-copy"><span class="pill">RESEARCH / EARLY ACCESS</span><h2>Meet the next step in <span class="accent-text">IRIS data streaming.</span></h2><p>IRIS CDC is an emerging approach to change data capture built around the IRIS journal and transaction stream—with Kafka as an initial destination.</p><p>We are speaking with engineering teams who need a different way to move operational changes into their data ecosystem.</p><div class="product-actions"><a class="button button-primary" href={href('products/iris-cdc/')}>Explore IRIS CDC ↗</a><a class="button button-ghost" href={href('products/iris-cdc/#early-access')}>Request early access →</a></div></div><div class="architecture" aria-label="Conceptual IRIS CDC data flow"><div class="arch-label">CONCEPTUAL DATA FLOW</div><div class="arch-node">InterSystems IRIS <span>DATABASE</span></div><div class="arch-arrow">↓</div><div class="arch-node">IRIS journal <span>CHANGE RECORDS</span></div><div class="arch-arrow">↓</div><div class="arch-node accent">CaretDev IRIS CDC <span>DECODING / STREAMING</span></div><div class="arch-arrow">↓</div><div class="arch-node">Apache Kafka <span>EVENT STREAM</span></div><div class="arch-label">PROTOTYPE · NOT A PRODUCTION GUARANTEE</div></div></div></section>
<section class="section"><div class="container"><div class="section-heading dark-heading"><span class="eyebrow">OPEN SOURCE, REAL ENGINEERING</span><h2>Tools people can actually use.</h2><p>Our GitHub projects help engineering teams connect IRIS to familiar frameworks and workflows.</p></div><div class="repo-grid">{repos.filter(r=>r.featured).slice(0,6).map(r=><a class="repo-card" href={`https://github.com/caretdev/${r.repo}`} target="_blank" rel="noopener noreferrer"><span class="repo-tag">{r.category.toUpperCase()}</span><h3>{r.name}</h3><p>{r.description}</p><span class="text-link">GitHub repository ↗</span></a>)}</div><div class="section-bottom"><a class="button button-outline" href={href('open-source/')}>See all projects ↗</a></div></div></section>
<CTA title="Your IRIS infrastructure has a future." body="We help teams move forward with confidence—integrating established systems with the technologies they need next." />
</Layout>
