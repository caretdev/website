---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import {services} from '../data/site';
---
<Layout title="Engineering services" description="InterSystems IRIS modernisation, integration, performance and reliability engineering from CaretDev."><section class="page-hero"><div class="container"><span class="eyebrow">ENGINEERING SERVICES</span><h1>Complex systems.<br/><span class="accent-text">Clearer paths forward.</span></h1><p class="lede">Focused engineering engagements for organisations building and operating business-critical systems on InterSystems technology.</p></div></section><section class="section"><div class="container"><div class="section-heading dark-heading"><span class="eyebrow">HOW WE HELP</span><h2>Specialised where it matters.</h2></div>{services.map(s=><div class="service-row"><span>{s.index}</span><div><h3>{s.title}</h3><p>{s.summary}</p></div><ul class="bullets">{s.items.map(item=><li>{item}</li>)}</ul></div>)}</div></section><section class="section section-dark"><div class="container"><div class="section-heading dark-heading"><span class="eyebrow">ENGAGEMENT MODEL</span><h2>Start with the actual problem.</h2><p>No vague transformation programme required. Define a concrete engineering challenge and a meaningful result.</p></div><div class="process-grid"><div class="process-step"><span class="eyebrow">01 / DISCOVER</span><h3>Technical discussion</h3><p>Understand the architecture, constraints and business impact.</p></div><div class="process-step"><span class="eyebrow">02 / DEFINE</span><h3>Focused scope</h3><p>Agree on outcomes, dependencies, delivery approach and commercial terms.</p></div><div class="process-step"><span class="eyebrow">03 / DELIVER</span><h3>Hands-on engineering</h3><p>Implement, review or troubleshoot with clear technical deliverables.</p></div></div></div></section><CTA title="Tell us what is difficult." body="A technical conversation is the best place to start. Share the problem, system constraints and your desired outcome." /></Layout>
