---
import Layout from '../layouts/Layout.astro';
import CTA from '../components/CTA.astro';
import {repos} from '../data/site';
---
<Layout title="Open source" description="CaretDev open-source projects bring InterSystems IRIS to SQLAlchemy, Django, TypeORM, dbt, LangChain, MCP and more."><section class="page-hero"><div class="container"><span class="eyebrow">THE DEVELOPER ECOSYSTEM</span><h1>Open by design.<br/><span class="accent-text">Practical by default.</span></h1><p class="lede">Integrations that make InterSystems IRIS feel at home in the frameworks, languages and workflows used by modern engineering teams.</p></div></section><section class="section"><div class="container"><div class="section-heading dark-heading"><span class="eyebrow">SELECTED REPOSITORIES</span><h2>Built in the open.</h2><p>Each link leads to its corresponding public GitHub repository. Check repository documentation for current compatibility and support status.</p></div><div class="repo-grid">{repos.map(r=><a class="repo-card" href={`https://github.com/caretdev/${r.repo}`} target="_blank" rel="noopener noreferrer"><span class="repo-tag">{r.category.toUpperCase()}</span><h3>{r.name}</h3><p>{r.description}</p><span class="text-link">View on GitHub ↗</span></a>)}</div><div class="section-bottom"><a href="https://github.com/caretdev" target="_blank" rel="noopener noreferrer" class="button button-outline">Visit the CaretDev organisation ↗</a></div></div></section><CTA title="Need to take it further?" body="If your environment needs a custom integration, production hardening or hands-on architecture work, we can help." /></Layout>
